// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": true,
   "pop_to_root_on_close": true,
   "escape_key_behavior": "close_window",
   "theme": {
      "dark": {
         "name": "stylix"
      }
   },
   "providers": {
      "@dagimg-dot/vicinae-extension-player-pilot-0": {
         "entrypoints": {
            "player-pilot": {
               "alias": "@pp"
            }
         }
      },
      "@fbosch/vicinae-extension-nerdfont-search-0": {
         "entrypoints": {
            "nerdfonts-search": {
               "alias": "@sf"
            }
         }
      },
      "@knoopx/vicinae-extension-nix-0": {
         "enabled": true,
         "entrypoints": {
            "home-manager-options": {
               "alias": "@nh"
            },
            "options": {
               "alias": "@no"
            },
            "packages": {
               "alias": "@np"
            }
         }
      },
      "@nino-mau/vicinae-extension-iconify-0": {
         "preferences": {
            "columns": "8",
            "customColor": "#111111",
            "iconColor": "currentColor",
            "iconNameFormat": "set-name:icon-name",
            "itemsPerPage": "800",
            "primaryAction": "copy"
         },
         "entrypoints": {
            "search-icons": {
               "alias": "@si"
            }
         }
      },
      "@ozer-01/vicinae-extension-aria2-manager-0": {
         "entrypoints": {
            "index": {
               "alias": "@dm"
            }
         }
      },
      "browser-extension": {
         "enabled": false
      },
      "clipboard": {
         "enabled": false,
         "preferences": {
            "eraseOnStartup": false,
            "ignorePasswords": true,
            "monitoring": false
         }
      },
      "core": {
         "entrypoints": {
            "about": {
               "enabled": false
            },
            "documentation": {
               "enabled": false
            },
            "keybind-settings": {
               "enabled": false
            },
            "list-extensions": {
               "enabled": false
            },
            "manage-fallback": {
               "enabled": false
            },
            "oauth-token-store": {
               "enabled": false
            },
            "open-config-file": {
               "enabled": false
            },
            "open-default-config": {
               "enabled": false
            },
            "reload-scripts": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "search-builtin-icons": {
               "enabled": false
            },
            "search-emojis": {
               "alias": "@se",
               "enabled": true,
               "preferences": {
                  "defaultAction": "copy",
                  "skinTone": "default"
               }
            },
            "settings": {
               "enabled": false
            },
            "sponsor": {
               "enabled": false
            },
            "store": {
               "enabled": false
            }
         }
      },
      "developer": {
         "enabled": false
      },
      "files": {
         "enabled": false,
         "preferences": {
            "autoIndexing": false,
            "excludedIndexingPaths": [],
            "indexingPaths": [
               "/home/jaugusto"
            ]
         }
      },
      "font": {
         "enabled": false
      },
      "manage-shortcuts": {
         "enabled": true
      },
      "power": {
         "entrypoints": {
            "hibernate": {
               "enabled": false
            },
            "lock": {
               "enabled": false
            },
            "logout": {
               "alias": "!l"
            },
            "power-off": {
               "alias": "!p"
            },
            "reboot": {
               "alias": "!r"
            },
            "sleep": {
               "enabled": false
            },
            "soft-reboot": {
               "enabled": false
            },
            "suspend": {
               "alias": "!s"
            }
         }
      },
      "raycast-compat": {
         "enabled": false
      },
      "system": {
         "enabled": false
      },
      "theme": {
         "enabled": false
      },
      "wm": {
         "enabled": false
      }
   }
}